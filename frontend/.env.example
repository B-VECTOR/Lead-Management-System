# Base URL of the Django REST backend. Copy this file to .env and adjust.
# Django's default dev port is 8000.
VITE_API_URL=http://localhost:8000

# Idle session timeout: minutes of no user activity before the session ends
# (the refresh token is blacklisted server-side), and how many minutes before
# that the "Still there?" warning appears. Omit either to take the default.
VITE_IDLE_TIMEOUT_MINUTES=30
VITE_IDLE_WARNING_MINUTES=2
